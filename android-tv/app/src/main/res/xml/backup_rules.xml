<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower (android:fullBackupContent). The login session must never be backed
     up. Keep in sync with data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="sharedpref" path="streetvoice_session.xml" />
    <!-- WebView login cookies -->
    <exclude domain="root" path="app_webview/" />
</full-backup-content>
